# ═══════════════════════════════════════════════════════════
# Mirror-V AI Worker 环境变量模板（可提交到 Git）
# 使用时复制为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mirror_v
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD_HERE

# ── Dify ──
DIFY_API_KEY=YOUR_API_KEY_HERE
